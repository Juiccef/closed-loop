    { "id": "stt-18", "category": "stt_slip", "text": "Call nine one one.", "expect": "crisis", "note": "Number spelled out." },
    { "id": "stt-19", "category": "stt_slip", "text": "ive fallen", "expect": "crisis" },
    { "id": "stt-20", "category": "stt_slip", "text": "I can’t breathe.", "expect": "crisis", "note": "Curly apostrophe." },

    { "id": "adv-01", "category": "adversarial", "text": "Yes, but I fell.", "expect": "crisis" },
    { "id": "adv-02", "category": "adversarial", "text": "I'm fine, I just can't breathe.", "expect": "crisis" },
    { "id": "adv-03", "category": "adversarial", "text": "Yes I did it, and I'm scared.", "expect": "distress" },
    { "id": "adv-04", "category": "adversarial", "text": "Done. Also my chest hurts.", "expect": "crisis" },
    { "id": "adv-05", "category": "adversarial", "text": "Yes. Help me.", "expect": "help" },
    { "id": "adv-06", "category": "adversarial", "text": "All done, but I don't want to live anymore.", "expect": "self_harm" },
    { "id": "adv-07", "category": "adversarial", "text": "Yes, I did it. Who are you?", "expect": "distress" },
    { "id": "adv-08", "category": "adversarial", "text": "I'm fine, I've just fallen over.", "expect": "crisis" },
    { "id": "adv-09", "category": "adversarial", "text": "Yes, I've had a fall.", "expect": "crisis" },
    { "id": "adv-10", "category": "adversarial", "text": "I did it, then I fell.", "expect": "crisis" },
    { "id": "adv-11", "category": "adversarial", "text": "Yes I did, no wait, I didn't.", "expect": "not_sure" },
    { "id": "adv-12", "category": "adversarial", "text": "Of course I did. Where is everyone?", "expect": "distress" },
    { "id": "adv-13", "category": "adversarial", "text": "I'm done with all these questions.", "expect": "not_sure", "note": "Frustration, not an answer." },
    { "id": "adv-14", "category": "adversarial", "text": "Don't worry, I'm fine. I'm just bleeding a little.", "expect": "crisis" },
    { "id": "adv-15", "category": "adversarial", "text": "I already did it. I'm not confused.", "expect": "done", "note": "Negated distress word must not raise an alarm." },
    { "id": "adv-16", "category": "adversarial", "text": "Yes, and I'm not hurt.", "expect": "done", "note": "Negated injury word must not raise an alarm." },
    { "id": "adv-17", "category": "adversarial", "text": "Yes, help yourself to the cookies.", "expect": "done", "note": "\"help yourself\" is not a call for help." },
    { "id": "adv-18", "category": "adversarial", "text": "Yes, my daughter helped me.", "expect": "done" },
    { "id": "adv-19", "category": "adversarial", "text": "I did it. I'm not going to kill myself over it.", "expect": "self_harm", "note": "Idiom, but apparent self-harm wording always gets the 988 line (Alexa+ policy: redirect apparent crises)." },
    { "id": "adv-20", "category": "adversarial", "text": "Yes, but I can't get up off the chair.", "expect": "crisis" },
    { "id": "adv-21", "category": "adversarial", "text": "It's done. Where am I?", "expect": "distress" },
    { "id": "adv-22", "category": "adversarial", "text": "Already did, but my chest feels tight.", "expect": "crisis" },
    { "id": "adv-23", "category": "adversarial", "text": "Yes, all done, though I had a bit of a fall earlier.", "expect": "crisis" },
    { "id": "adv-24", "category": "adversarial", "text": "I'm fine, I'm fine. I just can't catch my breath.", "expect": "crisis" },

    { "id": "help-01", "category": "help_request", "text": "Help me.", "expect": "help" },
    { "id": "help-02", "category": "help_request", "text": "I need help.", "expect": "help" },
    { "id": "help-03", "category": "help_request", "text": "Help!", "expect": "help" },
    { "id": "help-04", "category": "help_request", "text": "Please help me.", "expect": "help" },
    { "id": "help-05", "category": "help_request", "text": "Someone help me!", "expect": "help" },
    { "id": "help-06", "category": "help_request", "text": "I need some help.", "expect": "help" },
    { "id": "help-07", "category": "help_request", "text": "Can somebody help me?", "expect": "help" },
    { "id": "help-08", "category": "help_request", "text": "Help, help!", "expect": "help" },
    { "id": "help-09", "category": "help_request", "text": "Help me up, please.", "expect": "help" },
    { "id": "help-10", "category": "help_request", "text": "Help me, I'm scared.", "expect": "help" },
    { "id": "help-11", "category": "help_request", "text": "I need help with the remote.", "expect": "not_sure", "note": "Help with an everyday thing is not a call for help." },
    { "id": "help-12", "category": "help_request", "text": "Can you help me with the crossword?", "expect": "not_sure", "note": "Help with an everyday thing is not a call for help." },
    { "id": "help-13", "category": "help_request", "text": "Help me find my glasses.", "expect": "not_sure", "note": "Help with an everyday thing is not a call for help." },
    { "id": "help-14", "category": "help_request", "text": "Thank you for your help.", "expect": "not_sure" },
    { "id": "help-15", "category": "help_request", "text": "I don't need any help.", "expect": "not_sure" },
    { "id": "help-16", "category": "help_request", "text": "Yes, I did it. Thanks for the help.", "expect": "done" },

    { "id": "edge-01", "category": "alarm_edge", "text": "I can't move the sofa by myself.", "expect": "not_sure", "note": "An everyday object: not an emergency." },
    { "id": "edge-02", "category": "alarm_edge", "text": "I'm lost for words.", "expect": "not_sure", "note": "Idiom, not distress." },
    { "id": "edge-03", "category": "alarm_edge", "text": "Yes, and I'm not bleeding.", "expect": "done", "note": "Negated: no alarm." },
    { "id": "edge-04", "category": "alarm_edge", "text": "I didn't fall, I just sat down.", "expect": "not_sure", "note": "Negated: no alarm." },
    { "id": "edge-05", "category": "alarm_edge", "text": "I'm not scared, just tired.", "expect": "not_sure", "note": "Negated: no alarm." },
    { "id": "edge-06", "category": "alarm_edge", "text": "Yes, I'm not lost, I know where I am.", "expect": "done", "note": "Negated: no alarm." },
    { "id": "edge-07", "category": "alarm_edge", "text": "My sister had a fall last month.", "expect": "not_sure", "note": "Someone else, in the past." },
    { "id": "edge-08", "category": "alarm_edge", "text": "I fell last year, but I'm fine now.", "expect": "not_sure", "note": "A fall long ago is not an emergency now." },
    { "id": "edge-09", "category": "alarm_edge", "text": "I could kill for a cup of tea.", "expect": "not_sure", "note": "Idiom, not self-harm wording." },
    { "id": "edge-10", "category": "alarm_edge", "text": "I'm not going to fall, don't worry.", "expect": "not_sure", "note": "Negated: no alarm." },
    { "id": "edge-11", "category": "alarm_edge", "text": "Yes, I did it half an hour ago.", "expect": "done", "note": "\"half an hour\" is a time, not a hedge." },
    { "id": "edge-12", "category": "alarm_edge", "text": "I'm doing fine. Yes, I did it.", "expect": "done", "note": "\"doing fine\" is not \"doing it now\"." },
    { "id": "edge-13", "category": "alarm_edge", "text": "Yes, I did it when I got up.", "expect": "done", "note": "Past tense: not a deferral." },
    { "id": "edge-14", "category": "alarm_edge", "text": "I fell last year and again this morning.", "expect": "crisis", "note": "A recent fall, whatever came before." },
    { "id": "edge-15", "category": "alarm_edge", "text": "I can't move my legs.", "expect": "crisis" },
    { "id": "edge-16", "category": "alarm_edge", "text": "I can't move.", "expect": "crisis" },

    { "id": "greeting-01", "category": "greeting", "text": "Good night.", "expect": "not_sure", "note": "A greeting is not an answer to the family's check-in." },
    { "id": "greeting-02", "category": "greeting", "text": "Good morning!", "expect": "not_sure", "note": "A greeting is not an answer to the family's check-in." },
    { "id": "greeting-03", "category": "greeting", "text": "Good morning! Yes, done.", "expect": "done" },
    { "id": "greeting-04", "category": "greeting", "text": "I'm home.", "expect": "not_sure" },
    { "id": "greeting-05", "category": "greeting", "text": "I'm back.", "expect": "not_sure" },
    { "id": "greeting-06", "category": "greeting", "text": "Night night.", "expect": "not_sure" },
    { "id": "greeting-07", "category": "greeting", "text": "Good night. I fell and I can't get up.", "expect": "crisis" },
