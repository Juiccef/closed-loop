# Copy to .env and fill in. Never commit .env.
STACK_NAME=closed-loop
AWS_REGION=us-east-1
# Access code for the console, simulator, and admin endpoints (generate: openssl rand -hex 10)
ADMIN_TOKEN=
# Static bearer token for MCP clients (generate: openssl rand -hex 24)
MCP_BEARER_TOKEN=
# HMAC secret for acknowledge links (generate: openssl rand -hex 32)
ACK_LINK_SECRET=
# Verified SES identities (the SES sandbox only sends to verified addresses)
SES_SENDER=
SEED_L1_EMAIL=
SEED_L2_EMAIL=
# Optional: Bedrock model or inference profile for the planner, e.g. us.amazon.nova-lite-v1:0. Empty = rules planner.
BEDROCK_MODEL_ID=
